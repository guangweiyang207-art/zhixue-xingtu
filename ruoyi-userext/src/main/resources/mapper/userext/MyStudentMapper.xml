<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.userext.mapper.MyStudentMapper">

    <resultMap type="com.ruoyi.userext.domain.MyStudent" id="MyStudentResult">
        <result property="stuId" column="stu_id"/>
        <result property="userId" column="user_id"/>
        <result property="studentNo" column="student_no"/>
        <result property="major" column="major"/>
        <result property="grade" column="grade"/>
        <result property="className" column="class_name"/>
        <result property="birthday" column="birthday"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="rankLevel" column="rank_level"/>
        <result property="rankScore" column="rank_score"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="userName" column="real_name"/>
        <result property="teacherName" column="teacher_name"/>
        <result property="courseCount" column="course_count"/>
        <result property="homeworkCount" column="homework_count"/>
        <result property="totalQuestions" column="total_questions"/>
        <result property="correctQuestions" column="correct_questions"/>
        <result property="studyHours" column="study_hours"/>
    </resultMap>

    <sql id="selectMyStudentVo">
        select s.stu_id, s.user_id, s.student_no, s.major, s.grade, s.class_name, s.birthday, s.teacher_id, s.rank_level, s.rank_score, s.create_time, s.update_time,
               u.real_name as real_name, tu.real_name as teacher_name,
               count(distinct sc.c_id) as course_count,
               count(distinct sh.hw_id) as homework_count,
               count(distinct sq.q_id) as total_questions,
               sum(case when sq.score > 0 then 1 else 0 end) as correct_questions,
               ifnull(sum(sr.study_duration), 0) / 60.0 as study_hours
        from my_student s
        left join my_sys_user u on s.user_id = u.user_id
        left join my_teacher t on s.teacher_id = t.teacher_id
        left join my_sys_user tu on t.user_id = tu.user_id
        left join my_student_course sc on s.stu_id = sc.stu_id
        left join my_student_homework sh on s.stu_id = sh.stu_id and sh.status >= 1
        left join my_student_question sq on s.stu_id = sq.stu_id
        left join my_study_record sr on s.stu_id = sr.stu_id
    </sql>

    <select id="selectMyStudentList" parameterType="com.ruoyi.userext.domain.MyStudent" resultMap="MyStudentResult">
        <include refid="selectMyStudentVo"/>
        <where>
            <if test="studentNo != null and studentNo != ''">
                and s.student_no = #{studentNo}
            </if>
            <if test="userName != null and userName != ''">
                and u.real_name like concat('%', #{userName}, '%')
            </if>
            <if test="major != null and major != ''">
                and s.major = #{major}
            </if>
            <if test="className != null and className != ''">
                and s.class_name = #{className}
            </if>
        </where>
        group by s.stu_id
    </select>

    <select id="selectMyStudentByStuId" parameterType="Long" resultMap="MyStudentResult">
        <include refid="selectMyStudentVo"/>
        where s.stu_id = #{stuId}
        group by s.stu_id
    </select>

    <insert id="insertMyStudent" parameterType="com.ruoyi.userext.domain.MyStudent" useGeneratedKeys="true" keyProperty="stuId">
        insert into my_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="studentNo != null and studentNo != ''">student_no,</if>
            <if test="major != null and major != ''">major,</if>
            <if test="grade != null and grade != ''">grade,</if>
            <if test="className != null and className != ''">class_name,</if>
            <if test="birthday != null">birthday,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="rankLevel != null and rankLevel != ''">rank_level,</if>
            <if test="rankScore != null">rank_score,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="studentNo != null and studentNo != ''">#{studentNo},</if>
            <if test="major != null and major != ''">#{major},</if>
            <if test="grade != null and grade != ''">#{grade},</if>
            <if test="className != null and className != ''">#{className},</if>
            <if test="birthday != null">#{birthday},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="rankLevel != null and rankLevel != ''">#{rankLevel},</if>
            <if test="rankScore != null">#{rankScore},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateMyStudent" parameterType="com.ruoyi.userext.domain.MyStudent">
        update my_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="studentNo != null and studentNo != ''">student_no = #{studentNo},</if>
            <if test="major != null and major != ''">major = #{major},</if>
            <if test="grade != null and grade != ''">grade = #{grade},</if>
            <if test="className != null and className != ''">class_name = #{className},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="rankLevel != null and rankLevel != ''">rank_level = #{rankLevel},</if>
            <if test="rankScore != null">rank_score = #{rankScore},</if>
            update_time = sysdate()
        </trim>
        where stu_id = #{stuId}
    </update>

    <delete id="deleteMyStudentByStuId" parameterType="Long">
        delete from my_student where stu_id = #{stuId}
    </delete>

    <delete id="deleteMyStudentByStuIds">
        delete from my_student where stu_id in
        <foreach collection="array" item="stuId" open="(" separator="," close=")">
            #{stuId}
        </foreach>
    </delete>

    <update id="updateMySysUserRealName">
        update my_sys_user set real_name = #{realName} where user_id = #{userId}
    </update>

    <!-- 新增学生时同步插入 my_sys_user 账号：先以临时用户名占位插入，由 MyBatis useGeneratedKeys 回填 userId，再由 service 修正用户名 -->
    <insert id="insertMySysUserStudent" parameterType="java.util.Map" useGeneratedKeys="true" keyProperty="userId">
        insert into my_sys_user (username, password, real_name, user_type, status, is_deleted, create_time, update_time)
        values (#{username}, #{password}, #{realName}, 1, 1, 0, sysdate(), sysdate())
    </insert>

    <update id="updateMySysUserUsername">
        update my_sys_user set username = #{username} where user_id = #{userId}
    </update>

    <!-- 删除学生时同步清理：先取到 user_id 集合 -->
    <select id="selectUserIdsByStuIds" resultType="java.lang.Long">
        select user_id from my_student
        where stu_id in
        <foreach collection="array" item="stuId" open="(" separator="," close=")">
            #{stuId}
        </foreach>
        and user_id is not null
    </select>

    <delete id="deleteMySysUserByUserIds">
        delete from my_sys_user where user_id in
        <foreach collection="array" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

</mapper>
