<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mystudenthomework.mapper.MyStudentHomeworkMapper">

    <resultMap type="MyStudentHomework" id="MyStudentHomeworkResult">
        <result property="shId"    column="sh_id"    />
        <result property="stuId"    column="stu_id"    />
        <result property="hwId"    column="hw_id"    />
        <result property="answers"    column="answers"    />
        <result property="score"    column="score"    />
        <result property="teacherComment"    column="teacher_comment"    />
        <result property="status"    column="status"    />
        <result property="submitTime"    column="submit_time"    />
        <result property="correctTime"    column="correct_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMyStudentHomeworkVo">
        select sh_id, stu_id, hw_id, answers, score, teacher_comment, status, submit_time, correct_time, create_time, update_time from my_student_homework
    </sql>

    <select id="selectMyStudentHomeworkById" parameterType="Long" resultMap="MyStudentHomeworkResult">
        <include refid="selectMyStudentHomeworkVo"/>
        where sh_id = #{shId}
    </select>

    <select id="selectMyStudentHomeworkList" parameterType="com.ruoyi.mystudenthomework.domain.MyStudentHomework" resultMap="MyStudentHomeworkResult">
        <include refid="selectMyStudentHomeworkVo"/>
        <where>
            <if test="stuId != null "> and stu_id = #{stuId}</if>
            <if test="hwId != null "> and hw_id = #{hwId}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <insert id="insertMyStudentHomework" parameterType="com.ruoyi.mystudenthomework.domain.MyStudentHomework">
        insert into my_student_homework
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stuId != null">stu_id,</if>
            <if test="hwId != null">hw_id,</if>
            <if test="answers != null">answers,</if>
            <if test="score != null">score,</if>
            <if test="teacherComment != null">teacher_comment,</if>
            <if test="status != null">status,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="correctTime != null">correct_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stuId != null">#{stuId},</if>
            <if test="hwId != null">#{hwId},</if>
            <if test="answers != null">#{answers},</if>
            <if test="score != null">#{score},</if>
            <if test="teacherComment != null">#{teacherComment},</if>
            <if test="status != null">#{status},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="correctTime != null">#{correctTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMyStudentHomework" parameterType="com.ruoyi.mystudenthomework.domain.MyStudentHomework">
        update my_student_homework
        <trim prefix="SET" suffixOverrides=",">
            <if test="stuId != null">stu_id = #{stuId},</if>
            <if test="hwId != null">hw_id = #{hwId},</if>
            <if test="answers != null">answers = #{answers},</if>
            <if test="score != null">score = #{score},</if>
            <if test="teacherComment != null">teacher_comment = #{teacherComment},</if>
            <if test="status != null">status = #{status},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            <if test="correctTime != null">correct_time = #{correctTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where sh_id = #{shId}
    </update>

    <!-- 提交作业专用:按 (stu_id, hw_id) 强写 status=1、answers 等关键字段,避免动态 SQL 漏字段 -->
    <update id="submitMyStudentHomework" parameterType="com.ruoyi.mystudenthomework.domain.MyStudentHomework">
        update my_student_homework
        set answers      = #{answers},
            status       = #{status},
            submit_time  = #{submitTime},
            update_time  = #{updateTime}
        where stu_id = #{stuId} and hw_id = #{hwId}
    </update>

</mapper>
