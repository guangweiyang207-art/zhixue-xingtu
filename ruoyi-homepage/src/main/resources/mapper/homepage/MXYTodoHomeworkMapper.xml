<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.homepage.mapper.MXYTodoHomeworkMapper">

    <resultMap id="TodoHomeworkMap" type="com.ruoyi.homepage.domain.TodoHomework">
        <id     column="sh_id"         property="id"          />
        <result column="hw_id"         property="hwId"        />
        <result column="title"         property="title"       />
        <result column="stu_id"        property="stuId"       />
        <result column="real_name"     property="studentName" />
        <result column="student_no"    property="studentNo"   />
        <result column="class_name"    property="className"   />
        <result column="submit_time"   property="submitTime"  />
        <result column="status"        property="status"      />
    </resultMap>

    <select id="selectTodoHomeworkList" resultMap="TodoHomeworkMap">
        SELECT sh.sh_id, sh.hw_id, h.title, sh.stu_id, u.real_name,
            s.student_no, s.class_name,
            sh.create_time AS submit_time, sh.status
        FROM my_student_homework sh
        INNER JOIN my_homework h ON h.hw_id = sh.hw_id
        INNER JOIN my_student s ON s.stu_id = sh.stu_id
        INNER JOIN my_sys_user u ON u.user_id = s.user_id
        <where>
            <if test="teacherId != null">AND h.teacher_id = #{teacherId}</if>
            <if test="status != null">   AND sh.status    = #{status}</if>
            <if test="status == null">   AND sh.status    = 1</if>
        </where>
        ORDER BY sh.create_time DESC, sh.sh_id DESC
    </select>

</mapper>
