<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.myerrorbook.mapper.ExMyErrorBookMapper">

    <resultMap type="MyErrorBook" id="MyErrorBookResult">
        <result property="ebId"    column="eb_id"    />
        <result property="stuId"    column="stu_id"    />
        <result property="hqId"    column="hq_id"    />
        <result property="cId"    column="c_id"    />
        <result property="wrongAnswer"    column="wrong_answer"    />
        <result property="correctAnswer"    column="correct_answer"    />
        <result property="analysis"    column="analysis"    />
        <result property="tag"    column="tag"    />
        <result property="errorCount"    column="error_count"    />
        <result property="isMastered"    column="is_mastered"    />
        <result property="lastWrongTime"    column="last_wrong_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMyErrorBookVo">
        select eb_id, stu_id, hq_id, c_id, wrong_answer, correct_answer, analysis, tag, error_count, is_mastered, last_wrong_time, create_time, update_time from my_error_book
    </sql>

    <select id="selectMyErrorBookByStuId" parameterType="Long" resultMap="MyErrorBookResult">
        <include refid="selectMyErrorBookVo"/>
        where stu_id = #{stuId}
    </select>

</mapper>
