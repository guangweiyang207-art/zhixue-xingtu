<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.MyNotificationMapper">
    
    <resultMap type="MyNotification" id="MyNotificationResult">
        <result property="notiId"    column="noti_id"    />
        <result property="senderId"    column="sender_id"    />
        <result property="senderType"    column="sender_type"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="targetType"    column="target_type"    />
        <result property="targetIds"    column="target_ids"    />
        <result property="priority"    column="priority"    />
        <result property="isTop"    column="is_top"    />
        <result property="status"    column="status"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMyNotificationVo">
        select noti_id, sender_id, sender_type, title, content, target_type, target_ids, priority, is_top, status, publish_time, create_time, update_time from my_notification
    </sql>

    <select id="selectMyNotificationList" parameterType="MyNotification" resultMap="MyNotificationResult">
        <include refid="selectMyNotificationVo"/>
        <where>  
            <if test="senderId != null "> and sender_id = #{senderId}</if>
            <if test="senderType != null "> and sender_type = #{senderType}</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="content != null  and content != ''"> and content like concat('%', #{content}, '%')</if>
            <if test="targetType != null "> and target_type = #{targetType}</if>
            <if test="targetIds != null  and targetIds != ''"> and target_ids = #{targetIds}</if>
            <if test="priority != null "> and priority = #{priority}</if>
            <if test="isTop != null "> and is_top = #{isTop}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="publishTime != null "> and publish_time = #{publishTime}</if>
        </where>
    </select>
    
    <select id="selectMyNotificationByNotiId" parameterType="Long" resultMap="MyNotificationResult">
        <include refid="selectMyNotificationVo"/>
        where noti_id = #{notiId}
    </select>

    <insert id="insertMyNotification" parameterType="MyNotification" useGeneratedKeys="true" keyProperty="notiId">
        insert into my_notification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="senderId != null">sender_id,</if>
            <if test="senderType != null">sender_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null">content,</if>
            <if test="targetType != null">target_type,</if>
            <if test="targetIds != null">target_ids,</if>
            <if test="priority != null">priority,</if>
            <if test="isTop != null">is_top,</if>
            <if test="status != null">status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="senderId != null">#{senderId},</if>
            <if test="senderType != null">#{senderType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="targetType != null">#{targetType},</if>
            <if test="targetIds != null">#{targetIds},</if>
            <if test="priority != null">#{priority},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="status != null">#{status},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMyNotification" parameterType="MyNotification">
        update my_notification
        <trim prefix="SET" suffixOverrides=",">
            <if test="senderId != null">sender_id = #{senderId},</if>
            <if test="senderType != null">sender_type = #{senderType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="targetType != null">target_type = #{targetType},</if>
            <if test="targetIds != null">target_ids = #{targetIds},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="status != null">status = #{status},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where noti_id = #{notiId}
    </update>

    <delete id="deleteMyNotificationByNotiId" parameterType="Long">
        delete from my_notification where noti_id = #{notiId}
    </delete>

    <delete id="deleteMyNotificationByNotiIds" parameterType="String">
        delete from my_notification where noti_id in 
        <foreach item="notiId" collection="array" open="(" separator="," close=")">
            #{notiId}
        </foreach>
    </delete>
</mapper>