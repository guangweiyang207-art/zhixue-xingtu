<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mystudyreport.mapper.ExMyStudyReportMapper">

    <resultMap type="MyStudyReport" id="MyStudyReportResult">
        <result property="reportId"    column="report_id"    />
        <result property="stuId"    column="stu_id"    />
        <result property="reportType"    column="report_type"    />
        <result property="reportDate"    column="report_date"    />
        <result property="studyDuration"    column="study_duration"    />
        <result property="completedCourses"    column="completed_courses"    />
        <result property="completedHomework"    column="completed_homework"    />
        <result property="correctRate"    column="correct_rate"    />
        <result property="rankScoreChange"    column="rank_score_change"    />
        <result property="weakPoints"    column="weak_points"    />
        <result property="strengths"    column="strengths"    />
        <result property="suggestions"    column="suggestions"    />
        <result property="dataJson"    column="data_json"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <select id="selectLatestDailyReportByUserId" resultMap="MyStudyReportResult">
        select msr.* from my_study_report msr
        inner join my_student ms on msr.stu_id = ms.stu_id
        where ms.user_id = #{userId} and msr.report_type = 1
        order by msr.report_date desc
        limit 1
    </select>

</mapper>
