<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ycourse.mapper.YCourseMapper">

    <resultMap type="YCourse" id="YCourseResult">
        <result property="cId"    column="c_id"    />
        <result property="cName"    column="c_name"    />
        <result property="teacherId"    column="teacher_id"    />
        <result property="type"    column="type"    />
        <result property="tag"    column="tag"    />
        <result property="difficulty"    column="difficulty"    />
        <result property="maxPerson"    column="max_person"    />
        <result property="currentPerson"    column="current_person"    />
        <result property="description"    column="description"    />
        <result property="coverImage"    column="cover_image"    />
        <result property="status"    column="status"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="resourceId"    column="resource_id"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectYCourseVo">
        select c_id, c_name, teacher_id, type, tag, difficulty, max_person, current_person, description, cover_image, status, start_time, end_time, resource_id, remark, create_time, update_time from y_course
    </sql>

    <select id="selectYCourseById" parameterType="Long" resultMap="YCourseResult">
        <include refid="selectYCourseVo"/>
        where c_id = #{cId}
    </select>

    <select id="selectYCourseList" parameterType="com.ruoyi.ycourse.domain.YCourse" resultMap="YCourseResult">
        <include refid="selectYCourseVo"/>
        <where>
            <if test="cName != null  and cName != ''"> and c_name like concat('%', #{cName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
        </where>
    </select>

</mapper>